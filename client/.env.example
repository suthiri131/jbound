# Copy to .env and fill in. Vite only exposes vars starting with VITE_.

# Express API (local dev or your Render URL) — no trailing slash
VITE_API_URL=http://localhost:3000

# Supabase → Project Settings → API (the PUBLIC anon key only — never the service role key)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Maps Platform → Maps JavaScript API. This key IS visible in the browser, so restrict it to "Maps JavaScript API" + HTTP referrers (localhost:5173, your Vercel URL).
VITE_GOOGLE_MAPS_API_KEY=GOOGLE_MAPS_API_KEY
# Map ID for styled maps + advanced markers (Google Cloud → Map Management). DEMO_MAP_ID works for testing.
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID

# Clerk for Login
VITE_CLERK_PUBLISHABLE_KEY =CLERK_PUBLISHABLE_KEY

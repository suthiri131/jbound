# Copy to .env and fill in. NEVER commit .env.

PORT=3001
NODE_ENV=development

# Comma-separated list of allowed frontend origins (Vite dev + Vercel prod)
CLIENT_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key bypasses RLS. Server-side ONLY. Never ship to the Vue client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=jbound-images

# LTA DataMall (https://datamall.lta.gov.sg) — free AccountKey
LTA_ACCOUNT_KEY=your-LTA-account-key

# Google Maps Platform → Places API (New). Server-side key; restrict it to "Places API (New)".
# Billing must be enabled on the Google Cloud project (set a budget alert!).
GOOGLE_PLACES_API_KEY=your-google-places-key

# Optional overrides (defaults are already set in config.js)
FRANKFURTER_BASE_URL=https://api.frankfurter.dev

# OpenRouteService — keep this server-side; never expose it in a VITE_ variable.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org

# Password used for demo accounts created by `pnpm seed:demo`
DEMO_PASSWORD=JBound123!
